n Standard Time (JST/UTC+9).",fr:"• Certains articles d'actualit\xe9 ont \xe9t\xe9 traduits en partie \xe0 l'aide d'un logiciel de traduction automatique. Certaines formulations peuvent donc manquer de clart\xe9. Nous vous remercions de votre compr\xe9hension.\n• Sauf indication contraire, toutes les dates, heures et p\xe9riodes de lancement sont indiqu\xe9es selon l'heure standard du Japon (JST, UTC+9).",de:"*Ein Teil der Artikel unter NEWS wird maschinell \xfcbersetzt. Dadurch k\xf6nnen vereinzelt unnat\xfcrliche oder missverst\xe4ndliche Formulierungen vorkommen. Wir bitten um euer Verst\xe4ndnis.\n*Sofern nicht anders angegeben, beziehen sich alle Datums- und Zeitangaben sowie Angaben zu Ver\xf6ffentlichungszeitr\xe4umen auf die japanische Standardzeit (JST, UTC+9).",es:"* Algunos art\xedculos de noticias se han hecho con traducci\xf3n autom\xe1tica. Por lo tanto, es posible que haya expresiones dif\xedciles de entender. Te pedimos tu comprensi\xf3n.\n* Salvo que se indique lo contrario, todas las fechas y horas, as\xed como los periodos de lanzamiento, se expresan en horario est\xe1ndar de Jap\xf3n (JST, UTC+9).",it:"*Alcuni articoli fanno uso di traduzione automatica: pertanto, potrebbero risultare di difficile comprensione. Ci scusiamo per il disagio.\n*Laddove non specificato, tutte le date di lancio dei prodotti sono da intendersi nel fuso orario giapponese (JST, UTC+9)."};var eA=i(74190),eN=i(33271),e_=i(14970),eS=i(68751);function ez(){let e=(0,em._)(["\n              width: 33vw;\n              min-width: 180px;\n              max-width: 300px;\n              padding: 0 10px;\n            "]);return ez=function(){return e},e}class ej{attach(e){this.delegate=e}detach(){this.delegate=void 0}toNext(){var e;null==(e=this.delegate)||e.toNext()}toPrev(){var e;null==(e=this.delegate)||e.toPrev()}}let eH=a.forwardRef(function(e,t){let{children:i,className:r}=e,o=a.useRef(null),[l,s]=a.useState(1/0),[c,d]=a.useState(310),[p]=a.useState(()=>new ej);return a.useEff